{
  "name": "nelio",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @nelio/web dev",
    "build": "pnpm --filter @nelio/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @nelio/web lint",
    "test": "vitest run",
    "check:vendors": "node scripts/check-vendor-names.mjs",
    "db:generate": "pnpm --filter @nelio/db generate",
    "db:migrate:sql": "pnpm --filter @nelio/db migrate:sql",
    "tokens": "node packages/ui/scripts/build-tokens.mjs",
    "worker:dev": "pnpm --filter @nelio/worker-node dev"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
