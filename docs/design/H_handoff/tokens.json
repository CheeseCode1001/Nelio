    "sticker_card": "6px 6px 0 #0B0B14",
    "dark": "none"
  },
  "focus": {
    "ring": "3px solid #2F5BFF",
    "offset": "2px"
  },
  "touch_target_min": 44,
  "status": {
    "info": "blue",
    "ai": "pink (Nelio AI)",
    "success": "ok",
    "warning": "warn",
    "error": "err",
    "neutral": "neutral"
  },
  "rules": [
    "Flat colour only: no gradients, glows or glass",
    "Light is default; Dark has full token parity",
    "One primary (blue) or CTA (ink pill + lime arrow) action per view",
    "Pink = Nelio AI; never name AI or media vendors",
    "Status = icon + word + colour",
    "Stickers: 2px ink border, 3px hard shadow, tilted -6..6deg",
    "Skeletons pulse opacity; no shimmer gradients"
  ]
}