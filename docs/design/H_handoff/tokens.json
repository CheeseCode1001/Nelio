{
  "name": "Nelio",
  "version": "1.0",
  "themes": {
    "dark": {
      "bg": "#0D0D12",
      "s1": "#16161E",
      "s2": "#1F1F2A",
      "s3": "#292936",
      "bd": "#2E2E3C",
      "tx": "#F5F5F7",
      "mu": "#A9A9BC",
      "lime": "#D4FF3F",
      "onlime": "#0D0D12",
      "grape": "#B7A4FF",
      "ongrape": "#0D0D12",
      "blue": "#6CB4FF",
      "orange": "#FFB547",
      "red": "#FF7A7A",
      "teal": "#3DDBA0",
      "limeT": "#252D0E",
      "grapeT": "#231D3B",
      "blueT": "#12253A",
      "orangeT": "#382910",
      "redT": "#3A1818",
      "tealT": "#0F3026",
      "link": "#D4FF3F",
      "video": "#2A2240",
      "video2": "#163A33"
    },
    "light": {
      "bg": "#F6F6F1",
      "s1": "#FFFFFF",
      "s2": "#EFEFE8",
      "s3": "#E4E4DC",
      "bd": "#DCDCD2",
      "tx": "#121218",
      "mu": "#55556A",
      "lime": "#D4FF3F",
      "onlime": "#0D0D12",
      "grape": "#5333D6",
      "ongrape": "#FFFFFF",
      "blue": "#1F66C2",
      "orange": "#A35A00",
      "red": "#C53030",
      "teal": "#0E7A55",
      "limeT": "#EEFFB8",
      "grapeT": "#ECE7FF",
      "blueT": "#E2EEFC",
      "orangeT": "#FFF0D9",
      "redT": "#FDE4E4",
      "tealT": "#DDF5EC",
      "link": "#5A3DE6",
      "video": "#2A2240",
      "video2": "#163A33"
    }
  },
  "default_theme": "dark",
  "type": {
    "display": {
      "family": "Bricolage Grotesque",
      "weights": [
        500,
        700,
        800
      ],
      "source": "Google Fonts"
    },
    "body": {
      "family": "Inter",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "source": "Google Fonts"
    },
    "scale": {
      "display": 64,
      "page_title": 34,
      "h2": 28,
      "section": 20,
      "card_title": 17,
      "body_lg": 16,
      "body": 14,
      "small": 13,
      "label": 12
    },
    "line_height": {
      "tight": 1.1,
      "body": 1.5
    },
    "tracking": {
      "display": "-0.04em",
      "title": "-0.02em",
      "label_caps": "0.06em"
    }
  },
  "radius": {
    "control": 12,
    "row": 16,
    "card": 20,
    "panel": 24,
    "dialog": 28,
    "pill": 999
  },
  "spacing": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    48,
    56
  ],
  "focus": {
    "ring": "3px solid lime",
    "offset": "2px"
  },
  "touch_target_min": 44,
  "status": {
    "active": "lime",
    "ai": "grape",
    "scheduled": "blue",
    "needs_attention": "orange",
    "failed": "red",
    "published": "teal",
    "neutral": "neutral"
  },
  "rules": [
    "No gradients, glows or glassmorphism",
    "Lime (Volt) is never text on light backgrounds; use #3D4D00 on limeT",
    "One primary (lime) button per view",
    "Status = icon + word + colour, never colour alone",
    "Never name AI or media vendors in product copy; the AI is 'Nelio AI'"
  ]
}