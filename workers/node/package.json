{
  "name": "@nelio/worker-node",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "redis:ping": "node --env-file=../../apps/web/.env.local scripts/redis-ping.mjs",
    "dev": "tsx --env-file=../../apps/web/.env.local src/index.ts",
    "start": "tsx src/index.ts",
    "check:framework": "tsx --env-file=../../apps/web/.env.local scripts/framework-check.ts",
    "check:keys": "node --env-file=../../apps/web/.env.local scripts/check-keys.mjs",
    "storage:cors": "node --env-file=../../apps/web/.env.local scripts/set-cors.mjs",
    "check:pipeline": "tsx --env-file=../../apps/web/.env.local scripts/pipeline-check.ts",
    "admin:channel": "tsx --env-file=../../apps/web/.env.local scripts/review-channel.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@aws-sdk/client-s3": "^3.1171.0",
    "@expo-google-fonts/plus-jakarta-sans": "0.4.1",
    "@nelio/db": "workspace:*",
    "@nelio/domain": "workspace:*",
    "bullmq": "^6.7.5",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "ioredis": "^6.0.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^24.19.2",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15"
  }
}
