// Nelio database schema.
// Milestone 1 covers identity, tenancy, invitations, creator profiles, audit and idempotency.
// Milestone 3 adds agents, runs and steps, the activity feed, agent spend, notifications and the outbox.
// Milestone 4 adds media assets, transcripts, clip candidates, clip projects and revisions, renders, brand kits and posts.
// Later milestones add their own tables through new migrations (architecture document §5).
//
// Access model: the application connects with a privileged role through Prisma, server-side only,
// and every query is scoped by the tenancy helpers in src/tenancy.ts. Row-level security is enabled
// on every table with no policies, so the browser keys (anon / authenticated) can read nothing.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  creator
  business
  agency

  @@map("account_type")
}

enum OrgRole {
  owner
  admin

  @@map("org_role")
}

enum WorkspaceRole {
  manager
  editor
  viewer
  client_approver

  @@map("workspace_role")
}

enum WorkspaceKind {
  primary
  client

  @@map("workspace_kind")
}

enum Plan {
  free
  trial
  starter
  creator_pro
  business
  agency
  enterprise

  @@map("plan")
}

enum ThemePreference {
  light
  dark
  system

  @@map("theme_preference")
}

enum AutomationMode {
  manual
  assisted
  autonomous

  @@map("automation_mode")
}

enum VerificationStatus {
  unverified
  pending
  verified
  failed

  @@map("verification_status")
}

enum AuditActorType {
  user
  system
  platform_admin

  @@map("audit_actor_type")
}

/// Application user. `id` equals the Supabase Auth user id.
model User {
  id                    String          @id @db.Uuid
  email                 String          @unique @db.Citext
  fullName              String          @map("full_name")
  isPlatformAdmin       Boolean         @default(false) @map("is_platform_admin")
  theme                 ThemePreference @default(light)
  /// ST-03: turns off animations for this person regardless of the OS setting.
  reduceMotion          Boolean         @default(false) @map("reduce_motion")
  timezone              String          @default("Africa/Lagos")
  onboardingStep        Int             @default(0) @map("onboarding_step")
  onboardingCompletedAt DateTime?       @map("onboarding_completed_at") @db.Timestamptz(6)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?       @map("deleted_at") @db.Timestamptz(6)

  orgMemberships       OrganizationMembership[]
  workspaceMemberships WorkspaceMembership[]
  creatorProfile       CreatorProfile?
  invitationsSent      Invitation[]             @relation("InvitedBy")
  invitationsAccepted  Invitation[]             @relation("AcceptedBy")
  auditEvents          AuditEvent[]
  agentsCreated        Agent[]                  @relation("AgentCreatedBy")
  agentAuthorizations  AgentAuthorization[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  pushSubscriptions    PushSubscription[]

  @@map("users")
}

/// Unit of ownership and money (B §1).
model Organization {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String          @unique
  accountType    AccountType     @map("account_type")
  plan           Plan            @default(free)
  automationMode AutomationMode? @map("automation_mode")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(6)

  memberships          OrganizationMembership[]
  workspaces           Workspace[]
  workspaceMemberships WorkspaceMembership[]
  invitations          Invitation[]
  auditEvents          AuditEvent[]

  @@map("organizations")
}

model OrganizationMembership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      OrgRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

/// Unit of work (B §1). Agents, content, accounts and approvals always belong to one workspace.
model Workspace {
  id                        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                     String            @map("org_id") @db.Uuid
  name                      String
  slug                      String            @unique
  kind                      WorkspaceKind     @default(primary)
  timezone                  String            @default("Africa/Lagos")
  pausedAt                  DateTime?         @map("paused_at") @db.Timestamptz(6)
  pausedByUserId            String?           @map("paused_by_user_id") @db.Uuid
  /// Set when someone dismisses the setup checklist on the Command Center (ON-05).
  setupChecklistDismissedAt DateTime?         @map("setup_checklist_dismissed_at") @db.Timestamptz(6)
  /// Onboarding step 2 (ON-02): what the workspace is going for. Used by Nelio AI to plan.
  goals                     String[]          @default([])
  niche                     String?
  audience                  String?
  /// ST-07 AI & processing: default quality and caption language for new uploads.
  processingQuality         ProcessingQuality @default(balanced) @map("processing_quality")
  captionLanguage           String            @default("en") @map("caption_language")
  /// ST-07: let Nelio AI suggest posting times.
  suggestPostTimes          Boolean           @default(true) @map("suggest_post_times")
  createdAt                 DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                 DateTime?         @map("deleted_at") @db.Timestamptz(6)

  org         Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships WorkspaceMembership[]
  invitations Invitation[]
  auditEvents AuditEvent[]
  agents      Agent[]
  runs        AgentRun[]
  activity    ActivityEvent[]
  media       MediaAsset[]
  licenses    LicenseAgreement[]

  // Lets child tables carry (workspace_id, org_id) with a foreign key that proves they match.
  @@unique([id, orgId])
  @@index([orgId])
  @@map("workspaces")
}

model WorkspaceMembership {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  orgId       String        @map("org_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId, orgId], references: [id, orgId], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([orgId])
  @@map("workspace_memberships")
}

/// Invitation to an organization (orgRole) or to one workspace (workspaceRole). Exactly one is set.
/// Only a SHA-256 hash of the token is stored. Invitations last 7 days (journey J-02).
model Invitation {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String         @map("org_id") @db.Uuid
  workspaceId      String?        @map("workspace_id") @db.Uuid
  email            String         @db.Citext
  orgRole          OrgRole?       @map("org_role")
  workspaceRole    WorkspaceRole? @map("workspace_role")
  tokenHash        String         @unique @map("token_hash")
  invitedByUserId  String         @map("invited_by_user_id") @db.Uuid
  expiresAt        DateTime       @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?      @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId String?        @map("accepted_by_user_id") @db.Uuid
  revokedAt        DateTime?      @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace  Workspace?   @relation(fields: [workspaceId, orgId], references: [id, orgId], onDelete: Cascade)
  invitedBy  User         @relation("InvitedBy", fields: [invitedByUserId], references: [id])
  acceptedBy User?        @relation("AcceptedBy", fields: [acceptedByUserId], references: [id])

  @@index([orgId])
  @@index([workspaceId])
  @@index([email])
  @@map("invitations")
}

/// Licensed content owner (role R-CO). Free, no subscription, no organization needed.
model CreatorProfile {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  displayName        String             @map("display_name")
  primaryPlatform    String             @map("primary_platform")
  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  /// Milestone 5: the public listing in the licensing marketplace (LI-01, LI-02).
  bio                String             @default("")
  niche              String?
  listingStatus      ListingStatus      @default(draft) @map("listing_status")
  suspendedReason    String?            @map("suspended_reason")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  channels   CreatorChannel[]
  terms      LicenseTerms?
  videos     CreatorVideo[]
  agreements LicenseAgreement[]

  @@map("creator_profiles")
}

/// Append-only audit trail. A database trigger rejects UPDATE and DELETE.
model AuditEvent {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String?        @map("org_id") @db.Uuid
  workspaceId String?        @map("workspace_id") @db.Uuid
  actorUserId String?        @map("actor_user_id") @db.Uuid
  actorType   AuditActorType @default(user) @map("actor_type")
  action      String
  targetType  String?        @map("target_type")
  targetId    String?        @map("target_id")
  metadata    Json           @default("{}")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  org       Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  workspace Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor     User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
}

/// Makes retried mutations safe: the same (scope, key) is processed once.
model IdempotencyKey {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope     String
  key       String
  userId    String?  @map("user_id") @db.Uuid
  result    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([scope, key])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------- Milestone 3: agents, jobs, activity, notifications

enum AgentState {
  active
  paused
  budget_reached
  stopped

  @@map("agent_state")
}

enum RunTrigger {
  schedule
  manual
  strategist

  @@map("run_trigger")
}

/// One status set for runs and steps, matching the Activity Center chips (APP-03).
enum RunStatus {
  queued
  running
  blocked
  needs_approval
  confirming
  paused
  failed
  done
  canceled

  @@map("run_status")
}

enum SpendKind {
  reserve
  settle
  release

  @@map("spend_kind")
}

enum NotificationCategory {
  approvals
  publishing
  licenses
  billing
  security
  agents

  @@map("notification_category")
}

enum NotificationChannel {
  in_app
  email
  push

  @@map("notification_channel")
}

enum DeliveryStatus {
  pending
  sent
  skipped
  failed

  @@map("delivery_status")
}

/// An AI agent (APP-04 to APP-06). Sources and destinations become their own tables when uploads (MS 4),
/// licenses (MS 5) and social connections (MS 6) exist; until then they are id lists checked at run time.
model Agent {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String         @map("org_id") @db.Uuid
  workspaceId     String         @map("workspace_id") @db.Uuid
  name            String
  goal            String
  color           String
  shape           String
  mode            AutomationMode @default(assisted)
  state           AgentState     @default(active)
  pausedAt        DateTime?      @map("paused_at") @db.Timestamptz(6)
  pausedReason    String?        @map("paused_reason")
  stoppedAt       DateTime?      @map("stopped_at") @db.Timestamptz(6)
  /// { days: ("mon".."sun")[], time: "HH:MM" } in the workspace time zone. Null = runs only when started.
  schedule        Json?
  brandRules      String?        @map("brand_rules")
  sourceRefs      Json           @default("[]") @map("source_refs")
  destinationRefs Json           @default("[]") @map("destination_refs")
  weeklyBudget    Int            @map("weekly_budget")
  perRunLimit     Int            @map("per_run_limit")
  maxPostsPerDay  Int            @default(1) @map("max_posts_per_day")
  maxPostsPerWeek Int            @default(3) @map("max_posts_per_week")
  nextRunAt       DateTime?      @map("next_run_at") @db.Timestamptz(6)
  runCount        Int            @default(0) @map("run_count")
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace      Workspace            @relation(fields: [workspaceId, orgId], references: [id, orgId], onDelete: Cascade)
  createdBy      User                 @relation("AgentCreatedBy", fields: [createdByUserId], references: [id])
  runs           AgentRun[]
  authorizations AgentAuthorization[]
  spend          AgentSpend[]

  @@unique([id, workspaceId])
  @@index([workspaceId, state])
  @@index([nextRunAt])
  @@map("agents")
}

/// Explicit authorization for autonomous publishing (CreateAgent-Authorize). Immutable: widening the
/// limits needs a new row; revoking sets revokedAt. The exact limits the person saw are stored as `scope`.
model AgentAuthorization {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId      String    @map("agent_id") @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  scope        Json
  acknowledged Boolean
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)

  agent Agent @relation(fields: [agentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([agentId])
  @@map("agent_authorizations")
}

/// One run of work: an agent's run, processing one video, or rendering one clip. Each step runs as a queued job.
model AgentRun {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String     @map("org_id") @db.Uuid
  workspaceId      String     @map("workspace_id") @db.Uuid
  kind             RunKind    @default(agent)
  /// Null for work a person started by hand (processing an upload, rendering a clip).
  agentId          String?    @map("agent_id") @db.Uuid
  assetId          String?    @map("asset_id") @db.Uuid
  renderId         String?    @map("render_id") @db.Uuid
  number           Int
  trigger          RunTrigger
  status           RunStatus  @default(queued)
  /// Short machine reason for blocked / failed (budget, license, permission, timeout, needs_ms4 ...).
  reason           String?
  reasonText       String?    @map("reason_text")
  estimatedCredits Int        @default(0) @map("estimated_credits")
  actualCredits    Int        @default(0) @map("actual_credits")
  refundedCredits  Int        @default(0) @map("refunded_credits")
  idempotencyKey   String     @unique @map("idempotency_key")
  startedByUserId  String?    @map("started_by_user_id") @db.Uuid
  deadlineAt       DateTime   @map("deadline_at") @db.Timestamptz(6)
  startedAt        DateTime?  @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime?  @map("finished_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId, orgId], references: [id, orgId], onDelete: Cascade)
  agent     Agent?       @relation(fields: [agentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  asset     MediaAsset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)
  steps     RunStep[]
  spend     AgentSpend[]

  @@unique([id, workspaceId])
  @@unique([agentId, number])
  @@index([workspaceId, status, createdAt])
  @@index([assetId])
  @@map("agent_runs")
}

/// One step of a run (Upload & check, Transcribe, Detect scenes, Rank moments, Render ...).
model RunStep {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId            String    @map("run_id") @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  ordinal          Int
  kind             String
  title            String
  detail           String?
  status           RunStatus @default(queued)
  reason           String?
  reasonText       String?   @map("reason_text")
  estimatedCredits Int       @default(0) @map("estimated_credits")
  actualCredits    Int       @default(0) @map("actual_credits")
  attempts         Int       @default(0)
  maxAttempts      Int       @default(3) @map("max_attempts")
  /// When a failed step may be retried (provider limits such as "Retry after 00:00 UTC").
  retryAfter       DateTime? @map("retry_after") @db.Timestamptz(6)
  startedAt        DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  run AgentRun @relation(fields: [runId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([runId, ordinal])
  @@map("run_steps")
}

/// Append-only feed behind the Activity Center (APP-03) and the Command Center "Live" list.
/// A trigger broadcasts each row to the workspace's private realtime channel.
model ActivityEvent {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String     @map("org_id") @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  agentId     String?    @map("agent_id") @db.Uuid
  runId       String?    @map("run_id") @db.Uuid
  stepId      String?    @map("step_id") @db.Uuid
  type        String
  status      RunStatus?
  title       String
  detail      String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId, orgId], references: [id, orgId], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([runId, createdAt])
  @@map("activity_events")
}

/// Append-only agent spend: reserve before a step, then settle (actual) and release (the unused part).
/// Hard budgets are read from here. The billing credit ledger (MS 8) builds on the same entries.
model AgentSpend {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId   String?   @map("agent_id") @db.Uuid
  runId     String    @map("run_id") @db.Uuid
  stepId    String    @map("step_id") @db.Uuid
  /// Which attempt of the step this belongs to: a retried step reserves again.
  attempt   Int       @default(1)
  kind      SpendKind
  credits   Int
  weekStart DateTime  @map("week_start") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  agent Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  run   AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([stepId, attempt, kind])
  @@index([agentId, weekStart])
  @@map("agent_spend")
}

/// A notification for one person (NT-01). `dedupeKey` stops the same event notifying twice.
model Notification {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  orgId       String?              @map("org_id") @db.Uuid
  workspaceId String?              @map("workspace_id") @db.Uuid
  category    NotificationCategory
  title       String
  body        String?
  href        String?
  dedupeKey   String               @map("dedupe_key")
  readAt      DateTime?            @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String              @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         DeliveryStatus      @default(pending)
  attempts       Int                 @default(0)
  lastError      String?             @map("last_error")
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@map("notification_deliveries")
}

/// Per person and category; a missing row means the default for that category.
model NotificationPreference {
  id       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String               @map("user_id") @db.Uuid
  category NotificationCategory
  inApp    Boolean              @default(true) @map("in_app")
  email    Boolean              @default(true)
  push     Boolean              @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

/// A browser push subscription (web push / VAPID). Removed when the push service reports it gone.
model PushSubscription {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Transactional outbox: written in the same transaction as the change it announces, then moved to the
/// job queue by the dispatcher. Nothing is lost if Redis or the worker is down.
model OutboxEvent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic        String
  payload      Json
  dedupeKey    String    @unique @map("dedupe_key")
  availableAt  DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(6)
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([dispatchedAt, availableAt])
  @@map("outbox_events")
}

// ---------------------------------------------------------------- Milestone 4: media pipeline

enum MediaStatus {
  uploading
  uploaded
  processing
  ready
  failed
  blocked

  @@map("media_status")
}

/// Who owns an uploaded video (CL-02 "Who owns this video?"). Public visibility is never a license.
enum RightsBasis {
  own
  permission
  license

  @@map("rights_basis")
}

enum ProcessingQuality {
  fast
  balanced
  high

  @@map("processing_quality")
}

enum RunKind {
  agent
  process
  render

  @@map("run_kind")
}

enum RenderStatus {
  queued
  rendering
  ready
  failed
  canceled

  @@map("render_status")
}

enum PostState {
  draft
  needs_approval
  scheduled
  /// Licence revoked, expired or suspended: the post won't go out until it's resolved (LI-04, LI-09).
  on_hold
  published
  failed

  @@map("post_state")
}

/// A source video in the workspace (CL-01, CL-02). Files live in object storage under `storageKey`;
/// the browser uploads them directly with signed multipart URLs and never sees storage credentials.
model MediaAsset {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String            @map("org_id") @db.Uuid
  workspaceId      String            @map("workspace_id") @db.Uuid
  filename         String
  contentType      String            @map("content_type")
  sizeBytes        BigInt            @map("size_bytes")
  durationSec      Float?            @map("duration_sec")
  width            Int?
  height           Int?
  storageKey       String            @unique @map("storage_key")
  multipartId      String?           @map("multipart_id")
  status           MediaStatus       @default(uploading)
  statusText       String?           @map("status_text")
  rights           RightsBasis?
  rightsNote       String?           @map("rights_note")
  /// Short reference shown on clips ("rights r-881"), unique per workspace.
  rightsRef        String            @map("rights_ref")
  /// Milestone 5: set when the video comes from a creator under a licence. Every use re-checks the licence.
  licenseAgreementId String?         @map("license_agreement_id") @db.Uuid
  creatorVideoId     String?         @map("creator_video_id") @db.Uuid
  quality          ProcessingQuality @default(balanced)
  language         String            @default("en")
  estimatedCredits Int               @default(0) @map("estimated_credits")
  actualCredits    Int               @default(0) @map("actual_credits")
  uploadedByUserId String            @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(6)

  workspace  Workspace       @relation(fields: [workspaceId, orgId], references: [id, orgId], onDelete: Cascade)
  transcript Transcript?
  candidates ClipCandidate[]
  projects   ClipProject[]
  runs       AgentRun[]
  license    LicenseAgreement? @relation(fields: [licenseAgreementId], references: [id], onDelete: Restrict)

  @@unique([id, workspaceId])
  @@unique([workspaceId, rightsRef])
  @@index([licenseAgreementId])
  @@index([workspaceId, createdAt])
  @@map("media_assets")
}

/// Word-level transcript with speakers and scene cuts. `words`: [{ w, s, e, sp }] in ms; `scenes`: cut times in ms.
model Transcript {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId     String            @unique @map("asset_id") @db.Uuid
  workspaceId String            @map("workspace_id") @db.Uuid
  language    String
  quality     ProcessingQuality
  words       Json
  scenes      Json              @default("[]")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  asset MediaAsset @relation(fields: [assetId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([assetId, workspaceId])
  @@map("transcripts")
}

/// A moment Nelio AI suggests as a short (CL-03 "Best moments"). Scores are estimates, never promises.
model ClipCandidate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  rank        Int
  startMs     Int      @map("start_ms")
  endMs       Int      @map("end_ms")
  title       String
  hook        String
  score       Int
  reasons     Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  asset MediaAsset @relation(fields: [assetId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([assetId, rank])
  @@map("clip_candidates")
}

/// A clip being edited in the Clipping Studio. Every save is a numbered revision (Versions).
model ClipProject {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  assetId      String   @map("asset_id") @db.Uuid
  name         String
  startMs      Int      @map("start_ms")
  endMs        Int      @map("end_ms")
  hook         String
  captionStyle String   @default("bold_pop") @map("caption_style")
  /// Caption size as a percentage of the default, 80–140.
  captionSize  Int      @default(100) @map("caption_size")
  format       String   @default("9:16")
  brandKitId   String?  @map("brand_kit_id") @db.Uuid
  version      Int      @default(1)
  /// CL-04: the generated variants (hooks, formats, caption styles) and which are picked.
  variants     Json?
  createdById  String   @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  asset     MediaAsset        @relation(fields: [assetId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  revisions ProjectRevision[]
  renders   Render[]

  @@unique([id, workspaceId])
  @@index([workspaceId, updatedAt])
  @@map("clip_projects")
}

model ProjectRevision {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  number      Int
  snapshot    Json
  note        String?
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project ClipProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@map("project_revisions")
}

/// A rendered clip (CL-04 variants, CL-05 exports). Credits: estimated before, actual after; a failure is refunded.
model Render {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String       @map("org_id") @db.Uuid
  workspaceId      String       @map("workspace_id") @db.Uuid
  projectId        String       @map("project_id") @db.Uuid
  revision         Int
  label            String?
  /// The exact clip settings rendered (a variant, or the saved version).
  settings         Json?
  hook             String
  captionStyle     String       @map("caption_style")
  format           String
  resolution       String       @default("1080p")
  status           RenderStatus @default(queued)
  statusText       String?      @map("status_text")
  estimatedCredits Int          @map("estimated_credits")
  actualCredits    Int          @default(0) @map("actual_credits")
  storageKey       String?      @map("storage_key")
  sizeBytes        BigInt?      @map("size_bytes")
  runId            String?      @map("run_id") @db.Uuid
  createdById      String       @map("created_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  project ClipProject @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  posts   Post[]

  @@index([workspaceId, createdAt])
  @@map("renders")
}

/// Brand kit (ST-06): colours and caption look every agent and render uses.
model BrandKit {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  name         String
  primary      String
  accent       String
  captionFont  String   @default("Plus Jakarta Sans") @map("caption_font")
  captionStyle String   @default("bold_pop") @map("caption_style")
  /// Palette shown on ST-06, first colour = primary, second = accent (hex, up to 6).
  colours      String[] @default([])
  /// Voice & tone Nelio AI writes in for this brand.
  voice        String   @default("")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([workspaceId])
  @@map("brand_kits")
}

/// A post draft (CS-01, CS-02). Publishing to platforms arrives with social connections (Milestone 6).
model Post {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  renderId    String?   @map("render_id") @db.Uuid
  agentId     String?   @map("agent_id") @db.Uuid
  title       String
  /// script | caption | clip_caption
  kind        String    @default("clip_caption")
  /// Per-platform text: { instagram: { caption, firstComment }, youtube: { title, description }, script }.
  content     Json      @default("{}")
  caption     String    @default("")
  hashtags    String[]  @default([])
  platforms   String[]  @default([])
  state       PostState @default(draft)
  /// Milestone 5: "review" when the licence behind a published post was revoked (takedown checklist).
  rightsFlag  String?   @map("rights_flag")
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  render Render? @relation(fields: [renderId], references: [id], onDelete: SetNull)

  @@index([workspaceId, state, updatedAt])
  @@map("posts")
}

/// "Notify me" on gated features (CS-03 Original AI video, LI-10 Payouts). One row per person and feature;
/// creators have no workspace, so org and workspace are empty for them.
model FeatureInterest {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String?  @map("org_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  feature     String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, feature])
  @@map("feature_interest")
}

// ---------------------------------------------------------------- Milestone 5: licensing and the creator portal

enum ListingStatus {
  draft
  listed
  suspended

  @@map("listing_status")
}

enum LicenseType {
  free
  private
  /// Shown as "Coming later" until payouts exist (B-08). Never offered.
  paid

  @@map("license_type")
}

enum AgreementStatus {
  requested
  active
  declined
  revoked
  expired
  canceled

  @@map("agreement_status")
}

/// A channel the creator claims (LI-06). Verified only by signing in with that platform (oauth)
/// or by a platform admin checking evidence (manual). Never by public visibility.
model CreatorChannel {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId     String             @map("creator_id") @db.Uuid
  platform      String
  title         String
  handle        String?
  url           String?
  externalId    String?            @map("external_id")
  status        VerificationStatus @default(pending)
  /// oauth | manual
  method        String?
  evidence      Json               @default("{}")
  failureReason String?            @map("failure_reason")
  verifiedAt    DateTime?          @map("verified_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([platform, externalId])
  @@index([creatorId])
  @@map("creator_channels")
}

/// The creator's licensing terms (LI-07). Agreements keep a snapshot, so edits never change a licence already given.
model LicenseTerms {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId      String      @unique @map("creator_id") @db.Uuid
  licenseType    LicenseType @default(free) @map("license_type")
  /// clips | compilations
  allowedUses    String[]    @default(["clips"]) @map("allowed_uses")
  platforms      String[]    @default([])
  commercial     Boolean     @default(false)
  attribution    String      @default("")
  /// captions | crops | trims
  edits          String[]    @default(["captions", "crops", "trims"])
  /// Months a licence lasts from the day it starts; null = until revoked.
  expiresMonths  Int?        @default(12) @map("expires_months")
  hasThirdParty  Boolean     @default(false) @map("has_third_party")
  thirdPartyNote String      @default("") @map("third_party_note")
  version        Int         @default(0)
  publishedAt    DateTime?   @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("license_terms")
}

/// A video the creator offers for licensing. Creators upload it to Nelio; importing from a channel waits for B-01.
model CreatorVideo {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId     String    @map("creator_id") @db.Uuid
  title         String
  filename      String
  contentType   String    @map("content_type")
  sizeBytes     BigInt    @map("size_bytes")
  durationSec   Float?    @map("duration_sec")
  storageKey    String    @unique @map("storage_key")
  multipartId   String?   @map("multipart_id")
  /// uploading | ready | failed
  status        String    @default("uploading")
  /// Third-party music or footage the creator doesn't control: never licensable (LI-07 "Excluded videos").
  excluded      Boolean   @default(false)
  excludeReason String?   @map("exclude_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, createdAt])
  @@map("creator_videos")
}

/// A licence between a creator and a workspace (LI-03, LI-04, LI-09). `terms` is the snapshot agreed to.
model LicenseAgreement {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId     String          @map("creator_id") @db.Uuid
  orgId         String          @map("org_id") @db.Uuid
  workspaceId   String          @map("workspace_id") @db.Uuid
  type          LicenseType
  status        AgreementStatus
  terms         Json
  termsVersion  Int             @map("terms_version")
  requestNote   String?         @map("request_note")
  decisionNote  String?         @map("decision_note")
  requestedById String          @map("requested_by_id") @db.Uuid
  startsAt      DateTime?       @map("starts_at") @db.Timestamptz(6)
  expiresAt     DateTime?       @map("expires_at") @db.Timestamptz(6)
  decidedAt     DateTime?       @map("decided_at") @db.Timestamptz(6)
  revokedAt     DateTime?       @map("revoked_at") @db.Timestamptz(6)
  revokeReason  String?         @map("revoke_reason")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  workspace Workspace      @relation(fields: [workspaceId, orgId], references: [id, orgId], onDelete: Cascade)
  assets    MediaAsset[]

  @@index([workspaceId, status])
  @@index([creatorId, status])
  @@index([status, expiresAt])
  @@map("license_agreements")
}
