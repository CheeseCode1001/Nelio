# Copy to apps/web/.env.local and fill in. Never commit real values.

# --- Supabase (dev project) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key: safe in the browser. Row-level security denies it all table access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Database (server only) ---------------------------------------------
# Named NELIO_* on purpose: a machine-wide DATABASE_URL from another project would otherwise win over this file.
# Supabase dashboard > Connect > "Transaction pooler" string, with the database password.
NELIO_DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# "Session pooler" or direct string, used only for migrations.
NELIO_DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# --- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Jobs and notifications (Milestone 3) -------------------------------
# Hosted Redis for the job queues (rediss://...). Read by the worker only; the web app never talks to Redis.
NELIO_REDIS_URL=
# Optional queue key prefix (default "nelio"); lets two environments share one Redis.
NELIO_QUEUE_PREFIX=
# Interactive transaction time limit in ms (default 20000). Raise it for local development far from the database.
NELIO_TX_TIMEOUT_MS=
# Email for notifications. Until both are set, email copies are recorded as "skipped", never "sent".
NELIO_EMAIL_API_KEY=
NELIO_EMAIL_FROM=
# Web push. Generate a pair with: node -e "console.log(require('web-push').generateVAPIDKeys())" (in workers/node)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NELIO_VAPID_PRIVATE_KEY=
NELIO_VAPID_SUBJECT=mailto:you@example.com

# --- Later milestones (leave empty until needed) -------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SENTRY_DSN=
AI_API_KEY=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_NAV_SHOW_UNBUILT=
NEXT_PUBLIC_DEV_UI=
STATUS_NOTICE_TITLE=
STATUS_NOTICE_TEXT=
NEXT_PUBLIC_PWA_DEV=
