# Copy to apps/web/.env.local and fill in. Never commit real values.

# --- Supabase (dev project) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key: safe in the browser. Row-level security denies it all table access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Database (server only) ---------------------------------------------
# Named NELIO_* on purpose: a machine-wide DATABASE_URL from another project would otherwise win over this file.
# Supabase dashboard > Connect > "Transaction pooler" string, with the database password.
NELIO_DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# "Session pooler" or direct string, used only for migrations.
NELIO_DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# --- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Later milestones (leave empty until needed) -------------------------
REDIS_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
RESEND_API_KEY=
SENTRY_DSN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
AI_API_KEY=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_NAV_SHOW_UNBUILT=
NEXT_PUBLIC_DEV_UI=
STATUS_NOTICE_TITLE=
STATUS_NOTICE_TEXT=
NEXT_PUBLIC_PWA_DEV=
